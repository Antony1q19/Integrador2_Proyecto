# Imagen de PRODUCCIÓN (AWS ECS Fargate). La de desarrollo es Dockerfile (next dev con recarga).
# Tres etapas: instalar dependencias → compilar (next build) → imagen final mínima con el
# servidor "standalone" de Next.js (sin código fuente ni dependencias de desarrollo).

FROM node:20-alpine AS dependencias
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM node:20-alpine AS build
WORKDIR /app
COPY --from=dependencias /app/node_modules ./node_modules
COPY . .
# Interruptor del frontend: con valor, las pantallas usan la API real (no los datos de ejemplo).
# Se fija al compilar porque Next.js incrusta las variables NEXT_PUBLIC_* en el código del navegador.
ARG NEXT_PUBLIC_API_URL=activo
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL     NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production     NEXT_TELEMETRY_DISABLED=1     PORT=3001     HOSTNAME=0.0.0.0
# Sin privilegios de administrador dentro del contenedor.
RUN addgroup -S app && adduser -S app -G app
COPY --from=build --chown=app:app /app/.next/standalone ./
COPY --from=build --chown=app:app /app/.next/static ./.next/static
COPY --from=build /app/public ./public
USER app
EXPOSE 3001
CMD ["node", "server.js"]
