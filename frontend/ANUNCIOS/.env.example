# Variables de entorno de ANUNCIOS. Copia este archivo a ".env" (que está en .gitignore)
# y ajusta los valores para tu máquina.

# Server-side (Server Components de Next.js, corren DENTRO del contenedor "anuncios-service"):
# dirección del Gateway. El navegador nunca la usa ni la ve (no lleva el prefijo NEXT_PUBLIC_).
# - Con docker-compose: nombre del contenedor en su red interna.
# - Con `npm run dev` fuera de Docker (backend en Docker): http://localhost:8000/api/v1
GATEWAY_INTERNAL_URL=http://gateway:8000/api/v1

# Clave compartida entre el Gateway y los servidores de Next.js (ERP y ANUNCIOS): con ella Next.js
# le pasa al Gateway la IP real del usuario, para los límites por IP y el bloqueo tras 5 intentos
# fallidos de login. Debe ser IGUAL en backend/gateway/.env, frontend/ERP/.env y frontend/ANUNCIOS/.env.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FRONTEND_PROXY_SECRET=
