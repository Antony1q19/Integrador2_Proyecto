# Variables de entorno del ERP. Copia este archivo a ".env" (que ya está
# en .gitignore) y ajusta los valores para tu máquina.

# Interruptor mock/API que lee el navegador (ver
# features/postulantes/services/postulantesService.ts). Con esta variable
# presente, el listado de postulantes usa el backend real; el navegador
# solo llama a rutas propias del servidor (/api/postulantes,
# /api/auth/login) -nunca al Gateway directo, ni maneja el JWT-, así que
# el valor en sí no importa, solo que exista.
#
# Comenta o borra esta línea para volver a mock (comportamiento por
# defecto si no existe).
NEXT_PUBLIC_API_URL=activo

# Server-side (Next.js Route Handlers en app/api/**/route.ts, corren
# DENTRO del contenedor "erp-service"): dirección del Gateway.
# - Corriendo con docker-compose: nombre del contenedor en su red interna.
# - Corriendo `npm run dev` fuera de Docker (con el backend igual en
#   Docker, puerto publicado): usa http://localhost:8000/api/v1 en su lugar.
GATEWAY_INTERNAL_URL=http://gateway:8000/api/v1

# Clave compartida entre el Gateway y los servidores de Next.js (ERP y ANUNCIOS): con ella Next.js
# le pasa al Gateway la IP real del usuario, para los límites por IP y el bloqueo tras 5 intentos
# fallidos de login. Debe ser IGUAL en backend/gateway/.env, frontend/ERP/.env y frontend/ANUNCIOS/.env.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FRONTEND_PROXY_SECRET=
