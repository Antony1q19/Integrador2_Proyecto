{
  "components": {
    "schemas": {
      "ConversacionCrear": {
        "description": "Datos para crear una conversación nueva.",
        "properties": {
          "nombre": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Nombre",
            "type": "string"
          },
          "postulante_id": {
            "minLength": 1,
            "title": "Postulante Id",
            "type": "string"
          },
          "telefono": {
            "maxLength": 30,
            "minLength": 5,
            "title": "Telefono",
            "type": "string"
          }
        },
        "required": [
          "postulante_id",
          "nombre",
          "telefono"
        ],
        "title": "ConversacionCrear",
        "type": "object"
      },
      "ConversacionRespuesta": {
        "description": "Una conversación con el último mensaje y datos del postulante.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "no_leidos": {
            "title": "No Leidos",
            "type": "integer"
          },
          "nombre": {
            "title": "Nombre",
            "type": "string"
          },
          "postulante_id": {
            "title": "Postulante Id",
            "type": "string"
          },
          "registrado": {
            "default": true,
            "title": "Registrado",
            "type": "boolean"
          },
          "telefono": {
            "title": "Telefono",
            "type": "string"
          },
          "ultima_actividad": {
            "format": "date-time",
            "title": "Ultima Actividad",
            "type": "string"
          },
          "ultimo_entrante": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ultimo Entrante"
          },
          "ultimo_mensaje": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ultimo Mensaje"
          }
        },
        "required": [
          "id",
          "postulante_id",
          "nombre",
          "telefono",
          "ultima_actividad",
          "no_leidos"
        ],
        "title": "ConversacionRespuesta",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MensajeCrear": {
        "description": "Datos para enviar un mensaje nuevo.\n\nNO hace falta postulante_id: la conversación (por su id en la URL) ya sabe\ncon quién se está hablando.",
        "properties": {
          "texto": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Texto",
            "type": "string"
          }
        },
        "required": [
          "texto"
        ],
        "title": "MensajeCrear",
        "type": "object"
      },
      "MensajeRespuesta": {
        "description": "Un mensaje que se devuelve al frontend.",
        "properties": {
          "conversacion_id": {
            "title": "Conversacion Id",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "estado": {
            "title": "Estado",
            "type": "string"
          },
          "fecha": {
            "format": "date-time",
            "title": "Fecha",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "remitente": {
            "title": "Remitente",
            "type": "string"
          },
          "texto": {
            "title": "Texto",
            "type": "string"
          },
          "wamid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wamid"
          }
        },
        "required": [
          "id",
          "conversacion_id",
          "remitente",
          "texto",
          "fecha",
          "estado"
        ],
        "title": "MensajeRespuesta",
        "type": "object"
      },
      "PlantillaCrear": {
        "description": "Datos para mandar una plantilla nueva a revisión de Meta.",
        "properties": {
          "categoria": {
            "pattern": "^(MARKETING|UTILITY)$",
            "title": "Categoria",
            "type": "string"
          },
          "cuerpo": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Cuerpo",
            "type": "string"
          },
          "ejemplos": {
            "items": {
              "type": "string"
            },
            "title": "Ejemplos",
            "type": "array"
          },
          "idioma": {
            "default": "es",
            "maxLength": 10,
            "minLength": 2,
            "title": "Idioma",
            "type": "string"
          },
          "nombre": {
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[a-z0-9_]+$",
            "title": "Nombre",
            "type": "string"
          }
        },
        "required": [
          "nombre",
          "categoria",
          "cuerpo"
        ],
        "title": "PlantillaCrear",
        "type": "object"
      },
      "PlantillaEnviar": {
        "description": "Enviar una plantilla APROBADA a una conversación.",
        "properties": {
          "idioma": {
            "minLength": 2,
            "title": "Idioma",
            "type": "string"
          },
          "nombre": {
            "minLength": 1,
            "title": "Nombre",
            "type": "string"
          },
          "variables": {
            "items": {
              "type": "string"
            },
            "title": "Variables",
            "type": "array"
          }
        },
        "required": [
          "nombre",
          "idioma"
        ],
        "title": "PlantillaEnviar",
        "type": "object"
      },
      "PlantillaRapidaActualizar": {
        "properties": {
          "contenido": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Contenido",
            "type": "string"
          },
          "descripcion": {
            "default": "",
            "maxLength": 200,
            "title": "Descripcion",
            "type": "string"
          },
          "titulo": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Titulo",
            "type": "string"
          }
        },
        "required": [
          "titulo",
          "contenido"
        ],
        "title": "PlantillaRapidaActualizar",
        "type": "object"
      },
      "PlantillaRapidaRespuesta": {
        "properties": {
          "categoria": {
            "title": "Categoria",
            "type": "string"
          },
          "contenido": {
            "title": "Contenido",
            "type": "string"
          },
          "descripcion": {
            "title": "Descripcion",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "titulo": {
            "title": "Titulo",
            "type": "string"
          }
        },
        "required": [
          "id",
          "titulo",
          "descripcion",
          "categoria",
          "contenido"
        ],
        "title": "PlantillaRapidaRespuesta",
        "type": "object"
      },
      "PlantillaRespuesta": {
        "description": "Una plantilla de la cuenta de WhatsApp Business, con su estado de revisión en Meta.",
        "properties": {
          "categoria": {
            "title": "Categoria",
            "type": "string"
          },
          "cuerpo": {
            "title": "Cuerpo",
            "type": "string"
          },
          "estado": {
            "title": "Estado",
            "type": "string"
          },
          "idioma": {
            "title": "Idioma",
            "type": "string"
          },
          "motivo_rechazo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Motivo Rechazo"
          },
          "nombre": {
            "title": "Nombre",
            "type": "string"
          },
          "variables": {
            "title": "Variables",
            "type": "integer"
          }
        },
        "required": [
          "nombre",
          "categoria",
          "idioma",
          "estado",
          "cuerpo",
          "variables"
        ],
        "title": "PlantillaRespuesta",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
