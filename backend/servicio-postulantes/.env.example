ENTORNO=desarrollo
NOMBRE_SERVICIO=servicio-postulantes
DATABASE_URL=postgresql+asyncpg://postulantes_user:postulantes_pass@postgres:5432/postulantes_db

# Deben coincidir EXACTO con los del Gateway (mismo valor, copiado de
# gateway/.env). Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITMO=HS256
GATEWAY_SHARED_SECRET=

LOG_LEVEL=INFO
