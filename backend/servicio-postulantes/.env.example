ENTORNO=
NOMBRE_SERVICIO=

# Deben coincidir EXACTO con los del Gateway
JWT_SECRET=
JWT_ALGORITMO=
GATEWAY_SHARED_SECRET=

LOG_LEVEL=

# --- Cloudinary (donde se guardan los archivos que suben los usuarios) ---
# CLOUDINARY_CLOUD_NAME: FALTA. Es el "cloud name" que aparece arriba a la izquierda
# del Dashboard de Cloudinary (no es la API key). Sin él, subir un archivo responde
# un error 503 con el mensaje "Cloudinary no está configurado".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dirección interna de servicio-procesos-seleccion (para ocultar postulantes de empresas que el usuario no tiene asignadas).
URL_SERVICIO_PROCESOS_SELECCION=
