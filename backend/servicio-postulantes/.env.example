ENTORNO=desarrollo
NOMBRE_SERVICIO=servicio-postulantes
# --- Base de datos: SUPABASE (proyecto "talenterp-personas", esquema "postulantes") ---
# Cópiala desde Supabase: botón "Connect" > "Session pooler" (puerto 5432). Cambia [YOUR-PASSWORD]
# por tu contraseña (si tiene caracteres como @ # / : ?, escríbelos codificados: @ = %40, # = %23...)
# y deja al final "?ssl=require". NUNCA subas la URL real a git: este archivo SÍ se sube; ".env" no.
DATABASE_URL=postgresql+asyncpg://postgres.<ID-DEL-PROYECTO>:<CONTRASEÑA>@<HOST-DEL-POOLER>:5432/postgres?ssl=require
DB_SCHEMA=postulantes

# Deben coincidir EXACTO con los del Gateway
JWT_SECRET=
JWT_ALGORITMO=HS256
GATEWAY_SHARED_SECRET=

LOG_LEVEL=INFO
# --- Supabase Storage (donde se guardan los archivos que suben los usuarios) ---
# Del proyecto "talenterp-personas": Project Settings > API. SUPABASE_URL es la "Project URL".
# SUPABASE_SERVICE_KEY es la clave SECRETA ("service_role" o "secret key"): no la compartas ni la subas a git.
# El bucket (privado) se crea solo al encender el servicio.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=postulantes-documentos

# Dirección interna de servicio-procesos-seleccion (para ocultar postulantes de empresas que el usuario no tiene asignadas).
URL_SERVICIO_PROCESOS_SELECCION=http://servicio-procesos-seleccion:8003

# --- Correo con Mailjet (botón "Solicitar cuenta" en /postulantes del ERP) ---
# Claves: Mailjet > Account settings > API Key Management. La SECRET es secreta: solo en ".env".
# El remitente debe estar VALIDADO en Mailjet > Account settings > Sender addresses & domains
# (puede ser un Gmail; no hace falta dominio propio).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
CORREO_REMITENTE_EMAIL=
CORREO_REMITENTE_NOMBRE=TalentERP
# Dirección pública de ANUNCIOS (el correo enlaza a su página /registro).
URL_ANUNCIOS=http://localhost:3001
