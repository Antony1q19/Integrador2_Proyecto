ENTORNO=desarrollo
NOMBRE_SERVICIO=servicio-comunicaciones
LOG_LEVEL=INFO

# --- Base de datos: PostgreSQL local (docker-compose). En AWS se usa RDS (lo configura infra/aws).
DATABASE_URL=postgresql+asyncpg://talenterp:talenterp@postgres:5432/talenterp
DB_SCHEMA=comunicaciones

# Deben coincidir EXACTO con los del Gateway
JWT_SECRET=
JWT_ALGORITMO=HS256
GATEWAY_SHARED_SECRET=

# --- WhatsApp: Meta WhatsApp Cloud API (developers.facebook.com > tu app > WhatsApp > API Setup)
# Token permanente de un "usuario del sistema" (Business Settings > Usuarios del sistema).
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_API_VERSION=v23.0
# Palabra secreta que también se escribe en Meta > WhatsApp > Configuración > Webhook > "Token de verificación".
META_VERIFY_TOKEN=
# Clave secreta de la app (Meta > Configuración de la app > Básica): verifica que el webhook venga de Meta.
# Obligatoria fuera de desarrollo.
META_APP_SECRET=

# --- Otros servicios
URL_SERVICIO_POSTULANTES=http://servicio-postulantes:8001
URL_SERVICIO_PROCESOS_SELECCION=http://servicio-procesos-seleccion:8003
