ENTORNO=desarrollo
NOMBRE_SERVICIO=servicio-procesos-seleccion
# --- Base de datos: PostgreSQL local (docker-compose). En AWS se usa RDS (lo configura infra/aws).
DATABASE_URL=postgresql+asyncpg://talenterp:talenterp@postgres:5432/talenterp
DB_SCHEMA=procesos_seleccion

# Deben coincidir EXACTO con los del Gateway
JWT_SECRET=
JWT_ALGORITMO=HS256
GATEWAY_SHARED_SECRET=

LOG_LEVEL=INFO
# Dirección interna de servicio-empresas-vacantes (para saber qué anuncios/empresas puede ver cada usuario).
URL_SERVICIO_EMPRESAS_VACANTES=http://servicio-empresas-vacantes:8002

# Para comprobar que un postulante existe antes de evaluarlo (opcional)
URL_SERVICIO_POSTULANTES=http://servicio-postulantes:8001
