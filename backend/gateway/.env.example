ENTORNO=desarrollo
# --- Base de datos: SUPABASE (proyecto "talenterp-personas", esquema "usuario") ---
# Cópiala desde Supabase: botón "Connect" > "Session pooler" (puerto 5432). Cambia [YOUR-PASSWORD]
# por tu contraseña (si tiene caracteres como @ # / : ?, escríbelos codificados: @ = %40, # = %23...)
# y deja al final "?ssl=require". NUNCA subas la URL real a git: este archivo SÍ se sube; ".env" no.
DATABASE_URL=postgresql+asyncpg://postgres.<ID-DEL-PROYECTO>:<CONTRASEÑA>@<HOST-DEL-POOLER>:5432/postgres?ssl=require
DB_SCHEMA=usuario

JWT_SECRET=
JWT_ALGORITMO=HS256
JWT_MINUTOS_EXPIRACION=60

# Debe coincidir EXACTO con GATEWAY_SHARED_SECRET de servicio-postulantes
GATEWAY_SHARED_SECRET=

URL_SERVICIO_POSTULANTES=http://servicio-postulantes:8001
URL_SERVICIO_EMPRESAS_VACANTES=http://servicio-empresas-vacantes:8002
URL_SERVICIO_PROCESOS_SELECCION=http://servicio-procesos-seleccion:8003

# Orígenes permitidos: ERP (3000) y ANUNCIOS (3001)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

LOG_LEVEL=INFO

# Clave compartida entre el Gateway y los servidores de Next.js (ERP y ANUNCIOS): con ella Next.js
# le pasa al Gateway la IP real del usuario, para los límites por IP y el bloqueo tras 5 intentos
# fallidos de login. Debe ser IGUAL en backend/gateway/.env, frontend/ERP/.env y frontend/ANUNCIOS/.env.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FRONTEND_PROXY_SECRET=
