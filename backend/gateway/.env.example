ENTORNO=desarrollo
DATABASE_URL=postgresql+asyncpg://gateway_user:gateway_pass@postgres:5432/gateway_db

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# (o `openssl rand -hex 32`). Nunca reutilizar el mismo valor entre
# entornos (dev/staging/prod), y nunca commitear el valor real -por eso
# va en ".env", que está en .gitignore, no acá en ".env.example"-.
JWT_SECRET=
JWT_ALGORITMO=HS256
JWT_MINUTOS_EXPIRACION=60

# Debe coincidir EXACTO con GATEWAY_SHARED_SECRET de servicio-postulantes.
# Generar igual que JWT_SECRET, con un valor DISTINTO (no reusar el mismo).
GATEWAY_SHARED_SECRET=

URL_SERVICIO_POSTULANTES=http://servicio-postulantes:8001
# URL_SERVICIO_EMPRESAS_VACANTES= (todavía no existe ese microservicio)
# URL_SERVICIO_PROCESOS_SELECCION= (todavía no existe ese microservicio)

# Orígenes permitidos: ERP (3000) y ANUNCIOS (3001)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

LOG_LEVEL=INFO
