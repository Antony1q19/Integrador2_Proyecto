ENTORNO=desarrollo
NOMBRE_SERVICIO=servicio-empresas-vacantes
# --- Base de datos: SUPABASE (proyecto "talenterp-reclutamiento", esquema "empresas_vacantes") ---
# Cópiala desde Supabase: botón "Connect" > "Session pooler" (puerto 5432). Cambia [YOUR-PASSWORD]
# por tu contraseña (si tiene caracteres como @ # / : ?, escríbelos codificados: @ = %40, # = %23...)
# y deja al final "?ssl=require". NUNCA subas la URL real a git: este archivo SÍ se sube; ".env" no.
DATABASE_URL=postgresql+asyncpg://postgres.<ID-DEL-PROYECTO>:<CONTRASEÑA>@<HOST-DEL-POOLER>:5432/postgres?ssl=require
DB_SCHEMA=empresas_vacantes

# Deben coincidir EXACTO con los del Gateway (copia el mismo valor desde
# gateway/.env). Generar uno nuevo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA pongas aquí el valor real: este archivo SÍ se sube a git; el ".env" no.
JWT_SECRET=
JWT_ALGORITMO=HS256
GATEWAY_SHARED_SECRET=

LOG_LEVEL=INFO