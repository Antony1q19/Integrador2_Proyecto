ENTORNO=desarrollo
NOMBRE_SERVICIO=servicio-empresas-vacantes
# --- Base de datos: PostgreSQL local (docker-compose). En AWS se usa RDS (lo configura infra/aws).
DATABASE_URL=postgresql+asyncpg://talenterp:talenterp@postgres:5432/talenterp
DB_SCHEMA=empresas_vacantes

# Deben coincidir EXACTO con los del Gateway (copia el mismo valor desde
# gateway/.env). Generar uno nuevo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA pongas aquí el valor real: este archivo SÍ se sube a git; el ".env" no.
JWT_SECRET=
JWT_ALGORITMO=HS256
GATEWAY_SHARED_SECRET=

LOG_LEVEL=INFO
