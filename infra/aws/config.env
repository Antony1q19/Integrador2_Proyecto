# Configuración del despliegue en AWS (sin secretos: los secretos van en SSM Parameter Store,
# los sube configurar.sh desde los .env locales).
PROYECTO=talenterp
REGION=us-east-1
# Perfil de la AWS CLI con el que se despliega (aws configure list-profiles).
PERFIL_AWS=integrador
# Remitente de los correos (Amazon SES le envía un enlace de verificación: hay que hacer clic).
CORREO_REMITENTE=ibarraxaviee@gmail.com
# Quién recibe la alerta si el gasto del mes pasa el presupuesto.
CORREO_ALERTAS=ibarraxaviee@gmail.com
PRESUPUESTO_MENSUAL_USD=5
